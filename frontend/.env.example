# Resend API key. Required.
RESEND_API_KEY=

# Where enquiries are delivered. Defaults to hello@buildlyone.com.
NOTIFICATION_EMAIL=

# Sender identity. MUST be an address on a domain verified in Resend —
# the sandbox sender (onboarding@resend.dev) only delivers to the
# account owner, so enquiries from real visitors are silently lost.
MAIL_FROM="buildlyone <hello@buildlyone.com>"
